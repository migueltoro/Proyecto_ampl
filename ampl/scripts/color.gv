graph Coloring {
  graph [overlap=false];
  node [shape=circle, style=filled, colorscheme="set312"];
  1 [label="1", fillcolor="3"];
  2 [label="2", fillcolor="2"];
  3 [label="3", fillcolor="1"];
  4 [label="4", fillcolor="1"];
  5 [label="5", fillcolor="3"];
  6 [label="6", fillcolor="2"];
  7 [label="7", fillcolor="2"];
  8 [label="8", fillcolor="1"];
  9 [label="9", fillcolor="3"];
  10 [label="10", fillcolor="1"];
  1 -- 2;
  1 -- 3;
  1 -- 4;
  2 -- 3;
  2 -- 5;
  3 -- 6;
  4 -- 5;
  4 -- 7;
  5 -- 6;
  5 -- 8;
  6 -- 9;
  7 -- 8;
  7 -- 10;
  8 -- 9;
  9 -- 10;
  3 -- 7;
  2 -- 8;
}
